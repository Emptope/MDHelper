{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mdhelper.local/schemas/project-v1.schema.json",
  "title": "MDHelper project manifest schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mdhelper_version",
    "created_at",
    "inputs",
    "species_roles",
    "plot",
    "analyses"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "mdhelper_version": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topology", "trajectory"],
      "properties": {
        "topology": {"$ref": "#/$defs/input"},
        "trajectory": {"$ref": "#/$defs/input"},
        "index": {"$ref": "#/$defs/input"},
        "energy": {"$ref": "#/$defs/input"}
      }
    },
    "species_roles": {
      "type": "object",
      "additionalProperties": {
        "enum": ["cation", "anion", "solvent", "additive", "polymer", "surface", "other"]
      }
    },
    "plot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "selections", "scheme", "limits"],
      "properties": {
        "schema_version": {"const": 1},
        "selections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "result_id", "label", "visible", "color_id", "series", "group", "title"
            ],
            "properties": {
              "result_id": {"type": "string", "minLength": 1},
              "label": {"type": "string"},
              "visible": {"type": "boolean"},
              "color_id": {"type": "integer", "minimum": 0, "maximum": 16},
              "series": {"type": "string"},
              "group": {"type": "string"},
              "title": {"type": "string", "maxLength": 120}
            }
          }
        },
        "scheme": {"enum": ["residue_name", "fixed"]},
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x_min", "x_max", "y_min", "y_max", "y2_min", "y2_max"],
          "properties": {
            "x_min": {"type": ["number", "null"]},
            "x_max": {"type": ["number", "null"]},
            "y_min": {"type": ["number", "null"]},
            "y_max": {"type": ["number", "null"]},
            "y2_min": {"type": ["number", "null"]},
            "y2_max": {"type": ["number", "null"]}
          }
        }
      }
    },
    "analyses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "analysis_id",
          "analysis_type",
          "result_sha256",
          "committed_at"
        ],
        "properties": {
          "analysis_id": {"type": "string", "minLength": 1},
          "analysis_type": {"enum": ["rdf", "cumulative_rdf", "energy"]},
          "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "committed_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Relative when portable, otherwise absolute across Windows volumes."
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
