{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mdhelper.local/schemas/analysis-result-v1.schema.json",
  "title": "MDHelper analysis result schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysis_type",
    "data",
    "parameters",
    "units",
    "diagnostics",
    "provenance",
    "request",
    "warnings",
    "analysis_id",
    "created_at",
    "method_version",
    "schema_version"
  ],
  "properties": {
    "analysis_type": {"enum": ["rdf", "cumulative_rdf", "energy"]},
    "data": {"type": "object"},
    "parameters": {"type": "object"},
    "units": {"type": "object", "additionalProperties": {"type": "string"}},
    "diagnostics": {"type": "object"},
    "provenance": {"type": "object"},
    "request": {"$ref": "analysis-request-v1.schema.json"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "analysis_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "method_version": {"type": "string", "minLength": 1},
    "schema_version": {"const": 1}
  }
}
