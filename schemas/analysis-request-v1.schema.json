{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mdhelper.local/schemas/analysis-request-v1.schema.json",
  "title": "MDHelper analysis request schema v1",
  "oneOf": [
    {"$ref": "#/$defs/radial"},
    {"$ref": "#/$defs/energy"}
  ],
  "$defs": {
    "radial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_type",
        "topology",
        "trajectory",
        "reference",
        "selection",
        "r_max_nm",
        "bin_width_nm",
        "frames",
        "backend",
        "schema_version"
      ],
      "properties": {
        "analysis_type": {"enum": ["rdf", "cumulative_rdf"]},
        "topology": {"type": "string", "minLength": 1},
        "trajectory": {"type": "string", "minLength": 1},
        "reference": {"type": "string", "minLength": 1},
        "selection": {"type": "string", "minLength": 1},
        "index_file": {"type": "string", "minLength": 1},
        "r_max_nm": {"type": "number", "exclusiveMinimum": 0},
        "bin_width_nm": {"type": "number", "exclusiveMinimum": 0},
        "frames": {"$ref": "#/$defs/frames"},
        "backend": {"enum": ["auto", "native", "mdanalysis", "gromacs"]},
        "species_roles": {"$ref": "#/$defs/species_roles"},
        "parameter_provenance": {"type": "object"},
        "schema_version": {"const": 1}
      }
    },
    "energy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_type",
        "energy_file",
        "energy_terms",
        "backend",
        "schema_version"
      ],
      "properties": {
        "analysis_type": {"const": "energy"},
        "energy_file": {"type": "string", "minLength": 1},
        "energy_terms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "backend": {"enum": ["auto", "mdanalysis", "gromacs"]},
        "parameter_provenance": {"type": "object"},
        "schema_version": {"const": 1}
      }
    },
    "frames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "stop", "stride"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "stop": {"type": ["integer", "null"], "minimum": 0},
        "stride": {"type": "integer", "minimum": 1}
      }
    },
    "species_roles": {
      "type": "object",
      "additionalProperties": {
        "enum": ["cation", "anion", "solvent", "additive", "polymer", "surface", "other"]
      }
    }
  }
}
